<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="CoolSnesh.Avalonia.MainWindow"
        Title="CoolSnesh Downloads"
        Width="1380" Height="860"
        MinWidth="1000" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="#101827"
        FontFamily="Segoe UI"
        RequestedThemeVariant="Dark">
  <Window.Styles>
    <Style Selector="TextBlock">
      <Setter Property="Foreground" Value="#E8EEF8" />
    </Style>
    <Style Selector="Button">
      <Setter Property="Background" Value="#27344A" />
      <Setter Property="Foreground" Value="#DCE7F7" />
      <Setter Property="BorderBrush" Value="#35445C" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="Padding" Value="12,8" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button:pointerover">
      <Setter Property="Background" Value="#33445F" />
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="#1687D9" />
      <Setter Property="Foreground" Value="#FFFFFF" />
      <Setter Property="BorderBrush" Value="#1687D9" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.primary:pointerover">
      <Setter Property="Background" Value="#2798E8" />
    </Style>
    <Style Selector="Button.nav">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Padding" Value="14,11" />
      <Setter Property="Foreground" Value="#AEBBD0" />
    </Style>
    <Style Selector="Button.nav:pointerover">
      <Setter Property="Background" Value="#202D42" />
      <Setter Property="Foreground" Value="#F1F5FC" />
    </Style>
    <Style Selector="Button.nav.selected">
      <Setter Property="Background" Value="#263B56" />
      <Setter Property="Foreground" Value="#8ED0FF" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBox">
      <Setter Property="Background" Value="#1D293B" />
      <Setter Property="Foreground" Value="#EFF5FC" />
      <Setter Property="BorderBrush" Value="#35445C" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="Padding" Value="12,9" />
    </Style>
    <Style Selector="CheckBox">
      <Setter Property="Foreground" Value="#DCE7F7" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="66,*" ColumnDefinitions="244,*">
    <Border Grid.Row="0" Grid.ColumnSpan="2" Background="#171F2E" BorderBrush="#2D394E" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="244,*,Auto,Auto" Margin="18,0">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="11" VerticalAlignment="Center">
          <Border Width="36" Height="36" CornerRadius="9" Background="#1E83CC" BorderThickness="0" VerticalAlignment="Center" ClipToBounds="True">
            <Image Source="avares://CoolSnesh.Avalonia/Assets/App.png"
                   Width="36" Height="36" Stretch="UniformToFill"
                   HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel Spacing="1" VerticalAlignment="Center">
            <TextBlock Text="CoolSnesh" FontWeight="SemiBold" FontSize="15" />
            <TextBlock Text="DOWNLOADS" FontSize="9" Foreground="#8D9DB7" LetterSpacing="1.6" />
          </StackPanel>
        </StackPanel>
        <Border Grid.Column="1" Width="430" MaxWidth="450" Height="44" HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="8" BorderBrush="#35445C" BorderThickness="1" Background="#1D293B" ClipToBounds="True">
          <Grid ColumnDefinitions="Auto,*" Margin="0">
            <TextBlock Text="⌕" FontSize="23" Foreground="#8FA1BC" Margin="12,0,6,0" VerticalAlignment="Center" />
            <TextBox x:Name="SearchBox" Grid.Column="1"
                     PlaceholderText="Поиск приложений..."
                     FontSize="15"
                     MinHeight="42"
                     VerticalContentAlignment="Center"
                     BorderThickness="0"
                     Background="#1D293B"
                     Padding="10,8,14,8"
                     TextChanged="OnSearchChanged" />
          </Grid>
        </Border>
        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Button x:Name="RefreshButton" Content="↻  Проверить версии" Click="OnRefreshVersionsClick" />
        </StackPanel>
      </Grid>
    </Border>

    <Border Grid.Row="1" Grid.Column="0" Background="#141D2D" BorderBrush="#2D394E" BorderThickness="0,0,1,0" Padding="12,18">
      <Grid RowDefinitions="Auto,*,Auto">
        <StackPanel Spacing="5">
          <TextBlock Text="РАБОЧАЯ ОБЛАСТЬ" FontSize="10" Foreground="#71839F" Margin="10,0,0,8" LetterSpacing="1.3" />
          <Button x:Name="CatalogNav" Classes="nav selected" Content="▦   Каталог приложений" Click="OnCatalogClick" />
          <Button x:Name="DownloadsNav" Classes="nav" Content="⇩   Загрузки" Click="OnDownloadsClick" />
          <Button x:Name="HistoryNav" Classes="nav" Content="◷   История" Click="OnHistoryClick" />
        </StackPanel>
        <StackPanel Grid.Row="2" Spacing="10">
          <Border Height="1" Background="#2D394E" Margin="7,0,7,4" />
          <Button x:Name="AppUpdateButton"
                  Content="Обновить CoolSnesh"
                  MinHeight="36"
                  HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Center"
                  Padding="8,8"
                  FontSize="12"
                  Classes="primary"
                  IsVisible="False"
                  ToolTip.Tip="Доступна новая версия CoolSnesh Downloads"
                  Click="OnAppUpdateClick" />
          <TextBlock x:Name="AppVersionLabel"
                     Text="Версия 1.0.0"
                     FontSize="11"
                     Foreground="#8FA1BC"
                     Margin="13,-3,0,0" />
          <Button x:Name="SettingsNav" Classes="nav" Content="⚙   Настройки" Click="OnSettingsClick" />
          <Border Background="#1D293B" BorderBrush="#2D3B52" BorderThickness="1" CornerRadius="9" Padding="12">
            <StackPanel Spacing="6">
              <TextBlock Text="ПАПКА ЗАГРУЗКИ" FontSize="10" Foreground="#8293AE" LetterSpacing=".8" />
              <TextBlock x:Name="SidebarFolderLabel" Text="Рабочий стол" FontSize="12" TextWrapping="Wrap" MaxHeight="54" />
              <Button Content="Изменить папку" HorizontalAlignment="Stretch" Click="OnChooseFolderClick" />
            </StackPanel>
          </Border>
          <StackPanel Orientation="Horizontal" Spacing="7" Margin="4,2,0,0">
            <Ellipse Width="7" Height="7" Fill="#4FC790" VerticalAlignment="Center" />
            <TextBlock Text="Загрузчик готов" FontSize="11" Foreground="#8FA1BC" VerticalAlignment="Center" />
          </StackPanel>
        </StackPanel>
      </Grid>
    </Border>

    <Border Grid.Row="1" Grid.Column="1" Background="#101827" Padding="24,22,24,20">
      <ContentControl x:Name="PageHost" />
    </Border>
  </Grid>
</Window>
